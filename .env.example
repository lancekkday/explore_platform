# ── Ports（EC2 上若有衝突可改這裡）──────────────────────────────────────────────
# EC2 部署預設值：BACKEND_PORT=19426  FRONTEND_PORT=8086
# 本機開發不走 Docker，BACKEND_PORT / FRONTEND_PORT 不影響 vite dev server
BACKEND_PORT=19426
FRONTEND_PORT=8086

# ── Frontend paths ────────────────────────────────────────────────────────────
# Local dev: BACKEND_URL is the Vite proxy target (only used by vite dev server)
# Docker default (served at root):   VITE_API_URL=/api  VITE_BASE_URL=/
# Docker on EC2 subpath (/explore_platform):
#   VITE_API_URL=/explore_platform/api  VITE_BASE_URL=/explore_platform/
#   BACKEND_PORT=19426  FRONTEND_PORT=8086
BACKEND_URL=http://localhost:19426
VITE_API_URL=/api
VITE_BASE_URL=/

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
AI_PRICE_INPUT_PER_1M=0.150
AI_PRICE_OUTPUT_PER_1M=0.600

# ── Destination data (Docker: /app/data, local: path to be2_destinations_dump parent) ──
DEST_DUMP_DIR=

# ── KKDay v3 Search API ──────────────────────────────────────────────────────
KKDAY_SEARCH_AUTH_KEY=
KKDAY_SEARCH_DEVICE_ID=e5af2aba849682eebc53766e4487289f
KKDAY_SEARCH_COOKIE=

# ── Baseline 巡檢設定 ────────────────────────────────────────────────────────
# 排名下降閾值倍數：current_rank > expected_rank * N 視為 rank_drop（預設 3）
BASELINE_DROP_MULTIPLIER=3

# ── Stage 商品存在檢查 ────────────────────────────────────────────────────────
# 當 baseline 商品不在前 300 名搜尋結果時,即時打 stage URL 確認是「商品下架」
# 還是「排名 >300」。關掉的話一律標 "check_failed"。
STAGE_CHECK_ENABLED=true
STAGE_CHECK_TTL_SEC=600     # 同一個 prod_mid 在這秒數內不重複打 stage
STAGE_CHECK_TIMEOUT=8       # HEAD 請求 timeout (秒)
STAGE_CHECK_RETRIES=2       # 失敗重試次數 (不含首次)

# ── BigQuery（scripts/fetch_baseline_bq.py + 每日 cron 用） ──────────────────
# 認證二擇一：
#   1) Service Account JSON 檔路徑（推薦 production / Docker）
#      路徑必須在 host 與 container 內都可達 — docker-compose 會用同一個路徑
#      mount SA 檔進 container（見 docker-compose.yml）。建議放在 repo 外
#      （例：/home/ubuntu/.kkday/bq-sa.json）、chmod 600、不要 commit。
#   2) 本機 user ADC：先跑 `gcloud auth application-default login`，此欄可留空
GOOGLE_APPLICATION_CREDENTIALS=
# 計費 project（留空則用 SA 預設）
BQ_PROJECT_ID=kkday-data-dap-sit

# ── KKDay internal QA service (Playwright cookie fetching) ───────────────────
SECRET_SERVICE_URL=
SERVICE_URL=
AUTOMATION_TOKEN=
BROWSER=
AGENT=

# ── Replay Inspector (replay_inspector/,個性化搜尋事件回放器) ────────────────
# 主平台 header「回放」入口指向的 Streamlit URL (build-time 烘進前端;
# EC2 上設成使用者瀏覽器可達的位址,例 http://<host>:8301)
VITE_REPLAY_URL=http://localhost:8301
# Docker host ports (docker compose up 會連回放器一起起)
REPLAY_API_PORT=8300
REPLAY_UI_PORT=8301
# USE_FAKE=1            → demo 模式,不打 BQ (dw_analysis_record 落表前用這個)
# BQ_PROJECT_ID / BQ_DATASET → 預設 kkday-data-dap / dw_analysis_record
