-- ⚠ 2026-08-26 一度 SUPERSEDED:資料團隊自建 flat 中繼表
--   `dw_analysis_record.stream_search_record_flat`,平台當時改用它。
--   2026-08-27 跟 RD 討論後改回直查本檔的源表 `stream_search_record`
--   (見 spec/v1-spec.md §2.1、CLAUDE.md 紅線 1)——本檔目前仍不接線
--   (平台在 src/repo/bigquery.py 直接 on-demand 查,不經 dataform),
--   但這裡的 JSON path 對映是 src/repo/bigquery.py 的抽取依據,保留維護。

config {
  type: "incremental",
  schema: "dw_analysis_record",
  name: "search_event_daily",
  uniqueKey: ["session_id"],
  bigquery: {
    partitionBy: "TIMESTAMP_TRUNC(event_date, DAY)",
    clusterBy: ["keyword", "exp_version", "locale"],
    requirePartitionFilter: true
  },
  description: "搜尋事件回放器 event 層:一列一個 content 事件,已 join recall 的 uf/cf。承接既有 uf_from_stream.sql,額外落表 uf.lbs 與 cf 拆欄。"
}

-- =============================================================================
-- ⚠ 交付初稿:給資料團隊 review 併入 dataform repo(目前不接線,見上方)。
--   欄位 JSON path 已對 kkday-data-dap-ui 實跑真資料驗證過(2026-08-27,
--   event_date=2026-08-24,keyword=福岡),見 src/repo/bigquery.py module
--   docstring 與 CLAUDE.md 紅線 1;未能實測處仍標 -- TODO(verify)。
--   本節上方「一天付一次 193GB 成本」是早期用錯表名時的估算,已由
--   spec/v1-spec.md §2.1 與 CLAUDE.md 紅線 1 的真實成本認知取代,
--   不代表本表的實測數字。
--
-- 兩個 join 陷阱 (spec 2.4):
--   1. cache 可跨日:content.cache 引用的 recall.cache 可能來自前幾天,
--      join 視窗開 [D-1, D]
--   2. 不可對 recall 套 ltr_features 存在性 gate:recall.cache 會被剝掉
--      ltr_features 但保留完整 uf;套了 uf 覆蓋率會從 ~62% 掉到 ~5%
-- =============================================================================

WITH content AS (
  SELECT
    event_id AS session_id,
    event_date,
    event_type,
    cache_hit,                                                   -- 頂層欄位,優先用
    JSON_VALUE(data, '$.source_event_id')      AS source_event_id,
    -- ✗ 實測推翻 2026-08-27:$.request_type 這個欄位在真實 payload 裡根本
    --   不存在(對 event_date=2026-08-24 的 content 事件做過 TO_JSON_STRING(data)
    --   完整 dump,沒有這個 key)。原本這裡抽這欄、下面 WHERE 用它過濾
    --   'product.list',會把所有列表結果濾光 —— 已移除,event_type IN
    --   ('content','content.cache') 已足夠界定範圍(見 src/repo/bigquery.py
    --   同款修正、CLAUDE.md 紅線 1)。
    -- ✓ RESOLVED 2026-08-19:payload 欄位名 keyword (RD 確認 + 原表實測有值;
    --   $.query.lang / $.query.locale 同層,一併實測 ✓)
    JSON_VALUE(data, '$.query.keyword')        AS keyword,
    JSON_VALUE(data, '$.query.lang')           AS lang,           -- TODO(verify) path
    JSON_VALUE(data, '$.query.locale')         AS locale,         -- TODO(verify) path
    JSON_VALUE(data, '$.query.currency')       AS currency,       -- TODO(verify) path
    JSON_VALUE(data, '$.experiment.exp_version') AS exp_version,
    JSON_VALUE(data, '$.source')               AS source,         -- TODO(verify) path
    JSON_VALUE(data, '$.kkud')                 AS kkud,           -- TODO(verify) path
    JSON_VALUE(data, '$.member_uuid')          AS member_uuid,    -- TODO(verify) path
    -- PII:落表即遮罩為 /24,任何下游不會看到完整 IP (spec 3.1)
    CONCAT(NET.IP_TO_STRING(NET.IP_TRUNC(NET.SAFE_IP_FROM_STRING(
      JSON_VALUE(data, '$.ip')), 24)), '/24')  AS ip_masked,      -- TODO(verify) path
    NULLIF(TO_JSON_STRING(JSON_QUERY(data, '$.filter')), 'null') AS filter_json,
    SAFE_CAST(JSON_VALUE(data, '$.pagination.start') AS INT64)       AS page_start,
    SAFE_CAST(JSON_VALUE(data, '$.pagination.count') AS INT64)       AS page_count,
    SAFE_CAST(JSON_VALUE(data, '$.pagination.total_count') AS INT64) AS total_count,
    ARRAY_LENGTH(JSON_QUERY_ARRAY(data, '$.prods'))                  AS prod_cnt,   -- TODO(verify) path
    -- ✗ 2026-08-19 實測修正:content 事件「沒有」cf (cf_single=0/11) —
    --   cf 一律來自 recall 側 (見下方 recall CTE),在 content 抽會全 NULL
    NULLIF(TO_JSON_STRING(JSON_QUERY(data, '$.ltr_features')), 'null') AS ltr_features
  FROM ${ref("dw_analysis_record", "stream_search_record")}
  WHERE event_type IN ('content', 'content.cache')
    ${when(incremental(),
      `AND event_date >= TIMESTAMP(DATAFORM_VAR_RUN_DATE)
       AND event_date <  TIMESTAMP_ADD(TIMESTAMP(DATAFORM_VAR_RUN_DATE), INTERVAL 1 DAY)`)}
),

-- recall 層:uf 只掛在 recall / recall.cache (100% 覆蓋;content 側為 0)
-- ⚠ 不得加 ltr_features IS NOT NULL 之類的 gate (spec 2.4-2)
recall AS (
  SELECT
    event_id,
    JSON_VALUE(data, '$.query_understanding.normalized_keyword') AS normalized_keyword,
    JSON_VALUE(data, '$.user_id')                    AS user_id,      -- TODO(verify) path
    -- ⚠ NULLIF(..., 'null') 必要:path 不存在時 TO_JSON_STRING(JSON_QUERY(...))
    --   回「字串 'null'」而非 SQL NULL — 不清掉的話下面的 uf_absent /
    --   ltr_features_recovered 旗標永遠不會為 true
    -- ✓ RESOLVED 2026-08-19:本檔的源 dw_analysis_record.stream_search_record
    --   實測 (40 筆抽樣) — recall 的 uf/cf 為「單層」$.uf / $.cf
    --   (uf_single=100%, uf_double=0%)。
    -- ✓ 成本定案 2026-08-19:dw_analysis_record.stream_search_record 是 VIEW,
    --   data 欄為「原生 JSON 型別」→ per-path 計費有效 (實測 1hr 窗:
    --   dry-run 估 9.17GB、實際計費 12.6MB,728 倍差)。直接以本 view 為源即可,
    --   不需 staging、不需換源 dl_base;dry-run 數字僅為上限,成本以實跑為準。
    --   (dl_base 本尊多包一層 $.data.*,Kim 範例 SQL 是對 dl_base 寫的 — 若未來
    --   換源記得改 path。)
    NULLIF(TO_JSON_STRING(JSON_QUERY(data, '$.uf.intent')), 'null')  AS uf_intent,
    NULLIF(TO_JSON_STRING(JSON_QUERY(data, '$.uf.profile')), 'null') AS uf_profile,
    JSON_VALUE(data, '$.uf.profile_version')         AS uf_profile_version,
    -- ✓ 實測修正 2026-08-27:不是獨立欄位,是 uf.profile 這個
    --   {feature_name:{d,v,t}} 扁平特徵表裡兩個具名 feature 的值(跟其他
    --   uf.profile.* 特徵同構,見上面 uf_profile 的「原樣保留,不展平」)。
    --   第一輪隨機抽 20 筆 uf.profile 非空樣本沒搜到,一度誤判成「欄位不
    --   存在」——per-user 特徵覆蓋率各自獨立,換一個有訂單歷史的使用者
    --   重測才驗到(見 src/repo/bigquery.py 同款修正)。
    JSON_VALUE(data, '$.uf.profile.uf_user_type.d')       AS uf_user_type,
    JSON_VALUE(data, '$.uf.profile.uf_membership_tier.d') AS uf_membership_tier,
    NULLIF(TO_JSON_STRING(JSON_QUERY(data, '$.uf.lbs')), 'null')     AS uf_lbs,   -- 新增:原本未落表
    -- cf 拆欄 (實測:cf 只在 recall 側)。
    -- ✓ 定案 2026-08-19 (二次修正):cf_raw「落表」— per-path 計費是
    --   path × 掃過的分區,不是按命中列算:實測「單筆」uf 回查實際計費
    --   18GB,cf path 更大 → 平台端即時回查不可行。cf 的成本只能在
    --   dataform 每日單次掃描裡一起付 (spec 原設計正確)。
    NULLIF(TO_JSON_STRING(JSON_QUERY(data, '$.cf')), 'null')           AS cf_raw,
    JSON_VALUE(data, '$.cf.platform')          AS cf_platform,
    -- ✗ 實測推翻 2026-08-27:$.cf.hour/$.cf.weekday 不存在,實際巢狀在
    --   $.cf.time_context 底下(見 src/repo/bigquery.py 同款修正)。
    SAFE_CAST(JSON_VALUE(data, '$.cf.time_context.hour') AS INT64)    AS cf_hour,
    SAFE_CAST(JSON_VALUE(data, '$.cf.time_context.weekday') AS INT64) AS cf_weekday,
    JSON_VALUE(data, '$.cf.query.final')       AS cf_query_final,
    ARRAY(SELECT JSON_VALUE(t) FROM UNNEST(
      JSON_QUERY_ARRAY(data, '$.cf.query.tokens')) t)    AS cf_query_tokens,
    NULLIF(TO_JSON_STRING(JSON_QUERY(data, '$.ltr_features')), 'null') AS recall_ltr_features
  FROM ${ref("dw_analysis_record", "stream_search_record")}
  WHERE event_type IN ('recall', 'recall.cache')
    -- cache 跨日:join 視窗開 [D-1, D] (spec 2.4-1)
    ${when(incremental(),
      `AND event_date >= TIMESTAMP_SUB(TIMESTAMP(DATAFORM_VAR_RUN_DATE), INTERVAL 1 DAY)
       AND event_date <  TIMESTAMP_ADD(TIMESTAMP(DATAFORM_VAR_RUN_DATE), INTERVAL 1 DAY)`)}
)

-- TODO(verify):recall_key donor 邏輯沿用既有 uf_from_stream.sql —
--   FARM_FINGERPRINT(keyword+lang+locale+currency+filter+experiment+
--   ltr_features_version+prod_mids) 回收 recall.cache 被剝掉的 ltr_features。
--   ⚠ 下面的 COALESCE(joined recall row) 只是佔位:spec 3.1 的
--   ltr_features_recovered 定義是「由 cache donor 回收而來」,語意與
--   「從 join 到的 recall row 拿到」不同 — 併入 dataform 時必須以既有
--   donor 實作取代這段,旗標只在 donor 路徑補值時為 true。
SELECT
  c.* EXCEPT (ltr_features),
  r.normalized_keyword,
  r.user_id,
  r.uf_intent,
  r.uf_profile,
  r.uf_profile_version,
  r.uf_user_type,
  r.uf_membership_tier,
  r.uf_lbs,
  COALESCE(c.ltr_features, r.recall_ltr_features) AS ltr_features,
  (c.ltr_features IS NULL AND r.recall_ltr_features IS NOT NULL)
                                                  AS ltr_features_recovered,
  (r.event_id IS NULL)                            AS join_failed,
  (r.event_id IS NOT NULL AND r.uf_intent IS NULL
    AND r.uf_profile IS NULL AND r.uf_lbs IS NULL) AS uf_absent
FROM content c
LEFT JOIN recall r
  ON c.source_event_id = r.event_id
